<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>VoiceKey</string>
  <key>CFBundleDisplayName</key>
  <string>VoiceKey</string>
  <key>CFBundleIdentifier</key>
  <string>com.voicekey.app</string>
  <key>CFBundleVersion</key>
  <string>0.1.0</string>
  <key>CFBundleShortVersionString</key>
  <string>0.1.0</string>

  <!-- Microphone usage description shown in system prompt -->
  <key>NSMicrophoneUsageDescription</key>
  <string>VoiceKey uses the microphone to transcribe your speech locally. No audio is sent to any server.</string>

  <!-- Accessibility usage description -->
  <key>NSAppleEventsUsageDescription</key>
  <string>VoiceKey uses Accessibility to insert transcribed text into the app you're using.</string>

  <!-- Allow running in background (tray app) -->
  <key>LSUIElement</key>
  <true/>
</dict>
</plist>
